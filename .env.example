# ============================================================================
# PlayBeat Digital — Central Admin.  Copy to `.env.local` and fill in.
# NEVER commit `.env.local`. All of these are read SERVER-SIDE ONLY; none are
# exposed to the browser (no NEXT_PUBLIC_ prefix anywhere).
# ============================================================================

# ---------- Connector mode -------------------------------------------------
# 'live' = call the real APIs. Any app without credentials stays 'pending'
#          and is shown with NO metrics (never fabricated).
# 'demo' = use the clearly-labelled fixture dataset in lib/data.js.
PB_CONNECTOR_MODE=live

# ---------- Session / auth -------------------------------------------------
# 32+ random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
PB_SESSION_SECRET=
PB_CSRF_SECRET=
# Session policy (defaults shown)
PB_SESSION_IDLE_MINUTES=30
PB_SESSION_ABSOLUTE_HOURS=8
# Password hashing (bcrypt cost). 12 is a sane production floor.
BCRYPT_ROUNDS=12
# Where server-side session + audit + sync state is written.
# Local development fallback only. Vercel production must set DATABASE_URL or
# POSTGRES_URL and run `npm run db:migrate` before serving traffic.
PB_DATA_DIR=./data
DATABASE_URL=

# ---------- Bootstrap admin ------------------------------------------------
# Used once by `npm run seed:admin` to create the first account, then remove.
ADMIN_EMAIL=admin@playbeat.digital
ADMIN_PASSWORD=
# Optional: 32-char base32 TOTP secret to require MFA for this account.
ADMIN_TOTP_SECRET=

# ---------- Per-application connectors ------------------------------------
# PlayBeat.digital
PLAYBEAT_DIGITAL_API_URL=
PLAYBEAT_DIGITAL_API_KEY=

# PlayBeat.live
PLAYBEAT_LIVE_API_URL=
PLAYBEAT_LIVE_API_KEY=
# Read-only server-side dashboard bridge from PlayBeat Digital. Optional;
# the admin will show integration limits until this token is configured.
LIVE_DASHBOARD_TOKEN=

# MagXTV.click
MAGXTV_API_URL=
MAGXTV_API_KEY=

# MakeThisDeal.biz
MAKETHISDEAL_API_URL=
MAKETHISDEAL_API_KEY=

# Pulse CRM (uzzirulzz-cyber/eaedpulseplus)
PULSE_CRM_REPO=uzzirulzz-cyber/eaedpulseplus
PULSE_CRM_API_URL=
PULSE_CRM_API_KEY=

# ---------- Connector resilience ------------------------------------------
CONNECTOR_TIMEOUT_MS=8000
CONNECTOR_MAX_RETRIES=3
CONNECTOR_RATE_LIMIT=120
CONNECTOR_BREAKER_THRESHOLD=5
CONNECTOR_BREAKER_COOLDOWN_MS=60000

# ---------- Meta / WhatsApp (see README §9) -------------------------------
# REQUIRED, no default: pick the version you have tested against from
# https://developers.facebook.com/docs/graph-api/changelog/versions/
META_GRAPH_VERSION=
META_WABA_TOKEN=
META_PHONE_NUMBER_ID=
# Webhook signature verification (HMAC-SHA256 of the RAW body).
META_FB_APP_SECRET=
# The token you type into Meta's webhook setup form; echoed back on the GET handshake.
META_WEBHOOK_VERIFY_TOKEN=
